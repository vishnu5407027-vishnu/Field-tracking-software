# Copy to ".env" on the server and fill in real values:
#   cp .env.production.example .env
# docker-compose.prod.yml reads this file for every service.

# ── PostgreSQL (TimescaleDB) ────────────────────────────────────────────────
POSTGRES_USER=fieldtracking
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password
POSTGRES_DB=fieldtracking

# ── Django / API ────────────────────────────────────────────────────────────
# The password here MUST match POSTGRES_PASSWORD above. Host is the compose
# service name "db", not localhost.
DATABASE_URL=postgresql://fieldtracking:CHANGE_ME_to_a_strong_password@db:5432/fieldtracking
REDIS_URL=redis://redis:6379

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_random_secret
JWT_SECRET=CHANGE_ME_random_secret

DEBUG=0

# Hosts Django will serve. Use your EC2 public IP (and domain later), or "*".
ALLOWED_HOSTS=*

# Required for the Django admin login. Use your serving origin(s).
CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# Seed the demo tenant + users on first boot (set 0 for a clean install).
SEED_DEMO=1

# Set to 1 ONLY after you put the app behind a domain + HTTPS.
SECURE_SSL=0
